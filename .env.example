# System & Prompt Configuration
SYSTEM_PROMPT="You are a helpful voice assistant."
PROMPT_VERSION="v1.0"

# VAD Configuration
VAD_SILENCE_MS=600
VAD_MIN_SPEECH_MS=250

# Call Timeouts & Limits
MAX_CALL_SECONDS=600
SILENCE_TIMEOUT_SECONDS=120
STT_TIMEOUT_S=3.0
LLM_TIMEOUT_S=5.0
TTS_TIMEOUT_S=5.0
TOOL_TIMEOUT_S=5.0

# Provider Selection (real-mode defaults for deployment)
VAD_PROVIDER=silero
STT_PROVIDER=vosk
LLM_PROVIDER=groq
TTS_PROVIDER=piper

# Provider API Keys & Model
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Local Model Paths
SILERO_MODEL_PATH=models/silero_vad.onnx
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx

# Persistence & Server
DB_PATH=voice_agent.db
HOST=127.0.0.1
PORT=8000
